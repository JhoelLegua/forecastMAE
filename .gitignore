# ==============================================================================
# Git Ignore Rules for DemandMind
# ==============================================================================

# Entornos Virtuales de Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Archivos Sensibles y Variables de Entorno (NUNCA SUBIR CLAVES O CREDENCIALES)
.env
*.env
.env.*
!.env.example
microservice/.env
!microservice/.env.example

# Bytecode y Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Archivos de Datos Masivos Crudos (Descargados automáticamente vía src/download_data.py)
data/raw/*
!data/raw/.gitkeep

# Almacenamiento Local de Ejecución / Runtime (Logs, reportes y gráficos temporales)
microservice/storage/logs/*.log
microservice/storage/reports/*.json
microservice/storage/charts/*.png
microservice/static/charts/*.png

# Mantener estructura de carpetas en Git
!microservice/storage/logs/.gitkeep
!microservice/storage/reports/.gitkeep
!microservice/storage/charts/.gitkeep
!microservice/static/charts/.gitkeep

# Archivos de Sistema Operativo y Editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
