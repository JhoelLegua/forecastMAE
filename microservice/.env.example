# ==============================================================================
# DemandMind Microservice Configuration Template
# ==============================================================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Control de Análisis de Inteligencia Artificial (LLM)
# true: envía imagen y métricas al LLM para generar explicación de decisiones
# false: desactiva el análisis LLM (el reporte muestra métricas y gráficos sin explicación)
LLM_ANALYZE=true

# Google Gemini API Key (100% Gratuito en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Static Assets Path
STATIC_CHARTS_DIR=static/charts

# ==============================================================================
# Configuración Brevo SMTP (Notificaciones y Alertas)
# ==============================================================================
SMTP_ENABLED=False
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="tu_usuario_brevo@dominio.com"
SMTP_PASSWORD="tu_clave_smtp_brevo_aqui"
ALERT_SENDER_EMAIL="alertas@tudominio.com"
ALERT_RECIPIENT_EMAIL="admin@tudominio.com"
ALERT_MIN_SEVERITY="MEDIUM"  # LOW | MEDIUM | HIGH | CRITICAL

# ==============================================================================
# Infraestructura Cloud AWS vs Local
# ==============================================================================
# 1. Almacenamiento de Gráficos (S3 vs Local)
# true: Sube gráficos a Bucket S3 y retorna enlace público HTTPS
# false: Almacena gráficos en storage/charts/ local y retorna ruta local
USE_AWS_S3=false
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="demandmind-charts"
AWS_S3_CUSTOM_ENDPOINT=""

# 2. Base de Datos PostgreSQL (AWS RDS vs Local)
# true: Conecta a base de datos PostgreSQL en AWS RDS
# false: Conecta a base de datos PostgreSQL en entorno local (DBeaver/Docker)
USE_AWS_RDS=false
LOCAL_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/demandmind_db"
AWS_RDS_DATABASE_URL="postgresql+asyncpg://postgres:tu_password_rds@demandmind-db.xyz.us-east-1.rds.amazonaws.com:5432/demandmind_db"
