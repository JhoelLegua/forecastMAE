# ==============================================================================
# DemandMind Microservice Configuration
# ==============================================================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Control de Análisis de Inteligencia Artificial (LLM)
# true: envía imagen y métricas al LLM para generar explicación de decisiones
# false: desactiva el análisis LLM (el reporte muestra métricas y gráficos sin explicación)
LLM_ANALYZE=true

# Google Gemini API Key (100% Gratuito en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Static Assets Path
STATIC_CHARTS_DIR=static/charts

# ==============================================================================
# Configuración Brevo SMTP (Notificaciones y Alertas)
# ==============================================================================
SMTP_ENABLED=False
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="tu_usuario_brevo@dominio.com"
SMTP_PASSWORD="tu_clave_smtp_brevo_aqui"
ALERT_SENDER_EMAIL="alertas@tudominio.com"
ALERT_RECIPIENT_EMAIL="admin@tudominio.com"
ALERT_MIN_SEVERITY="MEDIUM"  # LOW | MEDIUM | HIGH
